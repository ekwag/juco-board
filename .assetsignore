# Files in this folder that should NOT be served as public static files --
# Wrangler skips anything matching these lines when uploading assets.
# (Nothing here is secret; this is just to keep dev/config files out of the
# public asset list, and to stop _worker.js itself from being served as a
# literal downloadable text file instead of being executed as the Worker.)
_worker.js
wrangler.toml
wrangler.*.txt
worker.js
DEPLOY.md
reviews.json
.assetsignore
